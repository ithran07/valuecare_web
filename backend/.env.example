# Same Postgres/Supabase database your POS Django project uses.
DB_NAME=medical_supplier_pos
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call this API (your storefront frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only needed if you turn on optional customer accounts (Supabase Auth).
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=change-me
SUPABASE_URL=https://your-project-ref.supabase.co
